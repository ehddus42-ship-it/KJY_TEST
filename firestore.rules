rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /scores/{scoreId} {
      // 누구나 랭킹을 읽을 수 있지만, 문서를 수정/삭제할 수는 없습니다.
      allow read: if true;

      // 새 기록만 추가할 수 있고, 형식이 올바른 경우만 허용합니다.
      allow create: if request.resource.data.keys().hasOnly(['ms', 'nickname', 'createdAt'])
        && request.resource.data.ms is int
        && request.resource.data.ms > 0
        && request.resource.data.ms < 60000
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() > 0
        && request.resource.data.nickname.size() <= 12;

      allow update, delete: if false;
    }
  }
}
